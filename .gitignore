# ==========================================
# SignalScope - Git Ignore
# ==========================================

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
ENV/
env/

# ------------------------------------------
# Environment Variables / Secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Node / React / Vite
# ------------------------------------------
node_modules/
dist/
build/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------
# AI / ML Model Files
# ------------------------------------------
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors

# ------------------------------------------
# Datasets
# ------------------------------------------
data/
dataset/
datasets/

# ------------------------------------------
# Training Outputs
# ------------------------------------------
runs/
checkpoints/
outputs/
wandb/

# ------------------------------------------
# IDE / Editors
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------
# Logs
# ------------------------------------------
*.log

# ------------------------------------------
# Temporary Files
# ------------------------------------------
*.tmp
*.temp
*.cache
# SignalScope local datasets
backend/dataset/
backend/dataset_expanded/
backend/dataset_universal/
backend/dataset_gemini/
backend/dataset_gemini_expanded/
backend/dataset_tigas/
backend/kaggle_gemini/

# Model weights
backend/models/*.pth
backend/models/*.pt
backend/models/*.onnx